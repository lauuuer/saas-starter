generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js (NextAuth) models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Stripe / billing
  stripeCustomerId String?       @unique
  subscription     Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Billing ----------

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
  unpaid
}

model Subscription {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  // Nullable: alguns estados de subscription (ex.: incomplete) podem não ter
  // current_period_end definido no payload. Tratar como ausente em vez de Invalid Date.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Webhook events (claim-then-process + idempotência) ----------

enum WebhookStatus {
  processing  // "claimed": uma invocação pegou o evento e está processando
  processed   // concluído com sucesso
  failed      // falhou após processar; elegível para reprocessamento
  dead_letter // excedeu o teto de tentativas; requer intervenção manual
}

model WebhookEvent {
  id        String        @id // o event.id do Stripe (barreira de idempotência)
  type      String
  status    WebhookStatus @default(processing)
  // Payload cru guardado para permitir reprocessamento assíncrono pelo worker
  // sem precisar re-buscar no Stripe.
  payload   String        @db.Text
  attempts  Int           @default(0)
  lastError String?       @db.Text
  // Quando o worker pode tentar de novo (backoff exponencial). Null = imediato.
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice para o worker varrer eventos pendentes por status + janela de retry.
  @@index([status, nextRetryAt])
}
