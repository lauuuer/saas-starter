# --- Database (Supabase) ---
# Connection pooling string (porta 6543) - usada pelo app em runtime
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (porta 5432) - usada pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth) ---
# Gere com: npx auth secret
AUTH_SECRET=""
# GitHub OAuth App
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
# Vem do `stripe listen` localmente, ou do endpoint criado no Dashboard em prod
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron worker ---
# Em produção na Vercel, o CRON_SECRET é provisionado AUTOMATICAMENTE — não
# precisa defini-lo. Para testar o worker LOCALMENTE, defina um valor aqui e
# chame a rota com o header: Authorization: Bearer <valor>.
CRON_SECRET=""

# --- Observabilidade ---
# Protege o endpoint /api/health/webhooks (telemetria operacional não deve ser
# pública). Configure um monitor HTTP (UptimeRobot/BetterStack) apontando para
# /api/health/webhooks?token=<valor> e alerte em "unhealthy" ou HTTP 503.
HEALTH_TOKEN=""
